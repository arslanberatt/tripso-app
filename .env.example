# Tripso app — ortam değişkeni şablonu. `.env` olarak kopyala ve doldur.
# EXPO_PUBLIC_* ile başlayanlar derleme sırasında paket içine inlenir (SDK 56).

# E-posta/şifre giriş + kayıt akışını aç/kapat.
# false → yalnız Google + Apple (varsayılan). true → ek olarak e-posta akışı.
EXPO_PUBLIC_AUTH_EMAIL_ENABLED=false
