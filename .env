# Tripso app — ortam değişkenleri.
# EXPO_PUBLIC_* ile başlayanlar derleme sırasında paket içine inlenir (SDK 56).
# Bu dosyayı değiştirince Metro'yu yeniden başlat (cache temizliği için: npx expo start -c).

# E-posta/şifre giriş + kayıt akışını aç/kapat.
# false → yalnız Google + Apple gösterilir (varsayılan).
# true  → ek olarak "E-posta ile devam et" akışı görünür.
EXPO_PUBLIC_AUTH_EMAIL_ENABLED=false
